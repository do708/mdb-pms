# ---- Database ----
# Lokaal: eigen Postgres. Op Vercel Runtime: DATABASE_URL = Neon **pooler** URL.
# Migraties zitten NIET in `npm run build` — apart: `npm run db:migrate`
# (bij voorkeur DIRECT_URL / POSTGRES_URL_NON_POOLING zonder pooler).
# DIRECT_URL mag NIET als enige runtime-URL: serverless × direct → te veel connecties (P2039).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mdb_pms"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/mdb_pms"
# PG_POOL_MAX="3"
# Vercel/Supabase-aliassen (optioneel): POSTGRES_URL_NON_POOLING, POSTGRES_PRISMA_URL, POSTGRES_URL

# ---- Auth (NextAuth v5) ----
# Genereer met: openssl rand -base64 32
AUTH_SECRET=""

# Lokaal mag dit weg. Op Vercel/productie verplicht: het live domein.
# AUTH_URL="https://pms.mdb-networks.nl"

# ---- Mail ----
RESEND_API_KEY=""
PROJECT_EMAIL="projects@mdb-networks.nl"

# ---- Cron (Vercel) ----
# Bearer-token voor /api/cron/user-document-expiry (document-verloop → projects@).
# Op Vercel: CRON_SECRET wordt automatisch gezet bij Cron Jobs; of zet zelf.
# CRON_SECRET=""

# ---- App ----
# Basis-URL voor QR-codes (/asset/MDB-G-00001). Op productie het live domein.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Gereedschap (Tool & Safety) ----
# Geen extra secrets. Capability-flags staan op User:
#   gereedschapBeheer | keurmeester | overzichtAlleAssets
# Seed (npx prisma db seed) zet Dominic/Linda/Michel + Admin123!

# ---- Supabase (storage) ----
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# ---- Synology NAS (archief) ----
# Zet STORAGE_ARCHIVE_ENABLED=true zodra credentials of mount kloppen.
# Opslagmodus (automatisch):
#   1) Synology FileStation API als SYNO_USERNAME + SYNO_PASSWORD gezet zijn
#   2) Anders lokale mount/mock via NAS_MOUNT_PATH (of ARCHIVE_FS_ROOT)
#   3) Dev zonder credentials: default .data/nas-archief
STORAGE_ARCHIVE_ENABLED="false"
SYNO_BASE_URL="https://mdbnetworks.de7.quickconnect.to"
SYNO_USERNAME=""
SYNO_PASSWORD=""
SYNO_ARCHIVE_ROOT="/mdb-pms/archief"
# SYNO_VERIFY_SSL="false"
# SYNO_QUICKCONNECT_ID="mdbnetworks"
#
# Lokale SMB/NFS-mount van dezelfde map als SYNO_ARCHIVE_ROOT, of een
# filesystem-mock voor development:
# NAS_MOUNT_PATH="/mnt/mdb-pms/archief"
# ARCHIVE_FS_ROOT=".data/nas-archief"
