generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String              @id @default(cuid())
  name               String?
  email              String              @unique
  password           String
  role               String              @default("user")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  active             Boolean             @default(true)
  assignments        AssignmentUser[]
  workorders         Workorder[]
  extraWorkorders    WorkorderEngineer[]
  forms              FormSubmission[]
  projectUren        ProjectUur[]        @relation("ProjectUurMonteur")
  projectUrenGeboekt ProjectUur[]        @relation("ProjectUurGeboektDoor")
}

model Customer {
  id          String       @id @default(cuid())
  name        String
  email       String?
  phone       String?
  address     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  color       String       @default("#2563eb")
  formSchema  Json?
  publicToken String?      @unique
  assignments Assignment[]
  projects    Project[]
  workorders  Workorder[]
  aanvragen   Aanvraag[]
}

// Publieke opdrachtaanvraag, ingediend door een opdrachtgever via de unieke
// link (/aanvraag?client_id=TOKEN). Wordt op het dashboard getoond en kan
// met "In behandeling nemen" omgezet worden naar een werkbon.
model Aanvraag {
  id            String   @id @default(cuid())
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId    String
  locatie       String?
  straat        String?
  huisnummer    String?
  postcode      String?
  plaats        String?
  schermen      String?
  beugel        String?
  stroom        String?
  internet      String?
  opmerkingen   String?
  aanvragerNaam String?
  specificaties Json?
  bijlagen      Json?
  status        String   @default("open")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Project {
  id               String             @id @default(cuid())
  number           String             @unique
  name             String
  /// Straat + huisnummer
  location         String?
  /// Plaats / woonplaats
  plaats           String?
  customerId       String
  geoffreerdeUren  Decimal?           @db.Decimal(10, 2)
  geoffreerdBedrag Decimal?           @db.Decimal(12, 2)
  offerteUrl       String?
  offerteFilename  String?
  status           String             @default("actief")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  customer         Customer           @relation(fields: [customerId], references: [id])
  workorders       Workorder[]
  uren             ProjectUur[]
  materialen       ProjectMateriaal[]
}

model ProjectUur {
  id             String   @id @default(cuid())
  projectId      String
  userId         String
  /// Wie de uren heeft ingevoerd (kan afwijken van userId bij boeken voor collega)
  bookedByUserId String?
  datum          DateTime
  uren           Decimal  @db.Decimal(6, 2)
  omschrijving   String?
  kilometers     Float?
  createdAt      DateTime @default(now())
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user           User     @relation("ProjectUurMonteur", fields: [userId], references: [id], onDelete: Cascade)
  bookedBy       User?    @relation("ProjectUurGeboektDoor", fields: [bookedByUserId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([userId])
  @@index([bookedByUserId])
}

model ProjectMateriaal {
  id            String    @id @default(cuid())
  projectId     String
  omschrijving  String
  factuurnummer String?
  leverancier   String?
  kosten        Decimal   @db.Decimal(12, 2)
  ingekochtOp   DateTime?
  createdAt     DateTime  @default(now())
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Workorder {
  id                 String                @id @default(cuid())
  title              String
  status             String                @default("ontvangen")
  projectId          String?
  customerId         String?
  /// Locatie / filiaalnaam staat in title; adresvelden hieronder (zelfde als Aanvraag)
  location           String?
  straat             String?
  huisnummer         String?
  postcode           String?
  city               String?
  contactPersoon     String?
  contactEmail       String?
  contactPhone       String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  description        String?
  werkInstructie     String?
  workDate           DateTime?
  internalNotes      String?
  number             String                @unique
  assignedUserId     String?
  plannedDate        DateTime?
  plannedEndDate     DateTime?
  plannedHours       Float?
  /// Heen + terug kantoor ↔ klus (berekend bij planning)
  plannedRoundTripKm Float?
  /// Rijtijd bij plannedRoundTripKm (zelfde dagroute, verdeeld per stop)
  plannedReisuren    Float?
  assignmentId       String?
  formData           Json?
  pdfData            Bytes?
  pdfGeneratedAt     DateTime?
  sentAt             DateTime?
  documents          Document[]
  assignedUser       User?                 @relation(fields: [assignedUserId], references: [id])
  assignment         Assignment?           @relation(fields: [assignmentId], references: [id])
  project            Project?              @relation(fields: [projectId], references: [id])
  customer           Customer?             @relation(fields: [customerId], references: [id])
  hardware           WorkorderHardware[]
  hours              WorkorderHour[]
  materials          WorkorderMaterial[]
  photos             WorkorderPhoto[]
  attachments        WorkorderAttachment[]
  signature          WorkorderSignature?
  extraEngineers     WorkorderEngineer[]
  forms              WorkorderForm[]
}

model WorkorderHour {
  id          String    @id @default(cuid())
  workorderId String
  date        DateTime?
  hours       Float?
  travelTime  Float?
  kilometers  Float?
  hotel       Boolean   @default(false)
  createdAt   DateTime  @default(now())
  workorder   Workorder @relation(fields: [workorderId], references: [id], onDelete: Cascade)
}

model WorkorderMaterial {
  id            String    @id @default(cuid())
  workorderId   String
  name          String
  articleNumber String?
  quantity      Float     @default(1)
  unit          String?
  note          String?
  createdAt     DateTime  @default(now())
  workorder     Workorder @relation(fields: [workorderId], references: [id], onDelete: Cascade)
}

model WorkorderHardware {
  id           String    @id @default(cuid())
  workorderId  String
  name         String
  brand        String?
  model        String?
  serialNumber String?
  quantity     Int       @default(1)
  location     String?
  status       String    @default("installed")
  createdAt    DateTime  @default(now())
  workorder    Workorder @relation(fields: [workorderId], references: [id], onDelete: Cascade)
}

model WorkorderPhoto {
  id          String    @id @default(cuid())
  workorderId String
  url         String
  filename    String?
  caption     String?
  createdAt   DateTime  @default(now())
  workorder   Workorder @relation(fields: [workorderId], references: [id], onDelete: Cascade)
}

model WorkorderAttachment {
  id           String    @id @default(cuid())
  workorderId  String
  url          String
  filename     String?
  originalName String?
  contentType  String?
  createdAt    DateTime  @default(now())
  workorder    Workorder @relation(fields: [workorderId], references: [id], onDelete: Cascade)
}

model WorkorderSignature {
  id           String    @id @default(cuid())
  workorderId  String    @unique
  customerName String?
  signatureUrl String?
  createdAt    DateTime  @default(now())
  workorder    Workorder @relation(fields: [workorderId], references: [id], onDelete: Cascade)
}

model Document {
  id          String     @id @default(cuid())
  name        String
  type        String
  url         String
  workorderId String?
  createdAt   DateTime   @default(now())
  workorder   Workorder? @relation(fields: [workorderId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String   @id @default(cuid())
  type        String   @default("workorder_sent")
  title       String
  message     String?
  workorderId String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model FormType {
  id             String          @id @default(cuid())
  key            String          @unique
  name           String
  sortOrder      Int             @default(0)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  workorderForms WorkorderForm[]
}

model WorkorderForm {
  id          String    @id @default(cuid())
  workorderId String
  formTypeId  String
  formData    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workorder   Workorder @relation(fields: [workorderId], references: [id], onDelete: Cascade)
  formType    FormType  @relation(fields: [formTypeId], references: [id])

  @@unique([workorderId, formTypeId])
}

model Assignment {
  id             String           @id @default(cuid())
  number         String           @unique
  type           String
  status         String           @default("new")
  title          String
  description    String?
  internalNotes  String?
  customerId     String
  plannedDate    DateTime?
  estimatedHours Float?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  customer       Customer         @relation(fields: [customerId], references: [id])
  users          AssignmentUser[]
  invoices       Invoice[]
  workorders     Workorder[]
}

model AssignmentUser {
  id           String     @id @default(cuid())
  assignmentId String
  userId       String
  createdAt    DateTime   @default(now())
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Invoice {
  id           String      @id @default(cuid())
  number       String      @unique
  status       String      @default("draft")
  amount       Float?
  assignmentId String?
  createdAt    DateTime    @default(now())
  assignment   Assignment? @relation(fields: [assignmentId], references: [id])
}

model FormSubmission {
  id        String   @id @default(cuid())
  type      String
  title     String
  status    String   @default("ingediend")
  data      Json
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model WorkorderEngineer {
  id          String    @id @default(cuid())
  workorderId String
  userId      String
  workorder   Workorder @relation(fields: [workorderId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id])

  @@unique([workorderId, userId])
}

/// Geocode-cache (Nominatim): genormaliseerd adres → coördinaten
model TravelGeocodeCache {
  id        String   @id @default(cuid())
  /// Lowercase trim van het zoekadres
  queryKey  String   @unique
  lat       Float?
  lon       Float?
  /// true = geocode mislukt (niet opnieuw blijven proberen)
  missed    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Route-cache (OSRM): MD5(vertrek_aankomst) of multi-stop pad
model TravelRouteCache {
  id            String   @id @default(cuid())
  /// MD5(normalize(from) + "_" + normalize(to)) of multi-stop key
  cacheKey      String   @unique
  fromAddress   String
  toAddress     String
  kilometers    Float
  durationHours Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
