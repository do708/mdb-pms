generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String              @id @default(cuid())
  name            String?
  email           String              @unique
  password        String
  role            String              @default("user")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  active          Boolean             @default(true)
  assignments     AssignmentUser[]
  workorders      Workorder[]
  extraWorkorders WorkorderEngineer[]
  forms           FormSubmission[]
}

model Customer {
  id          String       @id @default(cuid())
  name        String
  email       String?
  phone       String?
  address     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  color       String       @default("#2563eb")
  formSchema  Json?
  assignments Assignment[]
  projects    Project[]
  workorders  Workorder[]
}

model Project {
  id         String      @id @default(cuid())
  number     String      @unique
  name       String
  customerId String
  status     String      @default("new")
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  customer   Customer    @relation(fields: [customerId], references: [id])
  workorders Workorder[]
}

model Workorder {
  id             String              @id @default(cuid())
  title          String
  status         String              @default("ontvangen")
  projectId      String?
  customerId     String?
  location       String?
  city           String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  description    String?
  workDate       DateTime?
  internalNotes  String?
  number         String              @unique
  assignedUserId String?
  plannedDate    DateTime?
  plannedEndDate DateTime?
  assignmentId   String?
  formData       Json?
  documents      Document[]
  assignedUser   User?               @relation(fields: [assignedUserId], references: [id])
  assignment     Assignment?         @relation(fields: [assignmentId], references: [id])
  project        Project?            @relation(fields: [projectId], references: [id])
  customer       Customer?           @relation(fields: [customerId], references: [id])
  hardware       WorkorderHardware[]
  hours          WorkorderHour[]
  materials      WorkorderMaterial[]
  photos         WorkorderPhoto[]
  signature      WorkorderSignature?
  extraEngineers WorkorderEngineer[]
}

model WorkorderHour {
  id          String    @id @default(cuid())
  workorderId String
  date        DateTime?
  hours       Float?
  travelTime  Float?
  kilometers  Float?
  hotel       Boolean   @default(false)
  createdAt   DateTime  @default(now())
  workorder   Workorder @relation(fields: [workorderId], references: [id], onDelete: Cascade)
}

model WorkorderMaterial {
  id            String    @id @default(cuid())
  workorderId   String
  name          String
  articleNumber String?
  quantity      Float     @default(1)
  unit          String?
  note          String?
  createdAt     DateTime  @default(now())
  workorder     Workorder @relation(fields: [workorderId], references: [id], onDelete: Cascade)
}

model WorkorderHardware {
  id           String    @id @default(cuid())
  workorderId  String
  name         String
  brand        String?
  model        String?
  serialNumber String?
  quantity     Int       @default(1)
  location     String?
  status       String    @default("installed")
  createdAt    DateTime  @default(now())
  workorder    Workorder @relation(fields: [workorderId], references: [id], onDelete: Cascade)
}

model WorkorderPhoto {
  id          String    @id @default(cuid())
  workorderId String
  url         String
  filename    String?
  createdAt   DateTime  @default(now())
  workorder   Workorder @relation(fields: [workorderId], references: [id], onDelete: Cascade)
}

model WorkorderSignature {
  id           String    @id @default(cuid())
  workorderId  String    @unique
  customerName String?
  signatureUrl String?
  createdAt    DateTime  @default(now())
  workorder    Workorder @relation(fields: [workorderId], references: [id], onDelete: Cascade)
}

model Document {
  id          String     @id @default(cuid())
  name        String
  type        String
  url         String
  workorderId String?
  createdAt   DateTime   @default(now())
  workorder   Workorder? @relation(fields: [workorderId], references: [id], onDelete: Cascade)
}

model Assignment {
  id             String           @id @default(cuid())
  number         String           @unique
  type           String
  status         String           @default("new")
  title          String
  description    String?
  internalNotes  String?
  customerId     String
  plannedDate    DateTime?
  estimatedHours Float?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  customer       Customer         @relation(fields: [customerId], references: [id])
  users          AssignmentUser[]
  invoices       Invoice[]
  workorders     Workorder[]
}

model AssignmentUser {
  id           String     @id @default(cuid())
  assignmentId String
  userId       String
  createdAt    DateTime   @default(now())
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Invoice {
  id           String      @id @default(cuid())
  number       String      @unique
  status       String      @default("draft")
  amount       Float?
  assignmentId String?
  createdAt    DateTime    @default(now())
  assignment   Assignment? @relation(fields: [assignmentId], references: [id])
}

model FormSubmission {
  id        String   @id @default(cuid())
  type      String
  title     String
  status    String   @default("ingediend")
  data      Json
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model WorkorderEngineer {
  id          String    @id @default(cuid())
  workorderId String
  userId      String
  workorder   Workorder @relation(fields: [workorderId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id])

  @@unique([workorderId, userId])
}
