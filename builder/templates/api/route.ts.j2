import { NextResponse } from "next/server";


export async function GET() {

    return NextResponse.json({

        module: "{{ resource }}",

        status: "ok",

        message:
            "{{ resource }} API actief"

    });

}


export async function POST(
    request: Request
) {

    const body = await request.json();


    return NextResponse.json({

        module: "{{ resource }}",

        received: body

    });

}