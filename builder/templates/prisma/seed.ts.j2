import { PrismaClient } from "@prisma/client";


const prisma = new PrismaClient();


async function main() {

    await prisma.user.upsert({

        where: {
            email: "admin@mdb-networks.nl"
        },

        update: {},

        create: {

            name: "Administrator",

            email: "admin@mdb-networks.nl",

            role: "admin"

        }

    });


    console.log(
        "✓ Admin user created"
    );

}


main()
    .then(async () => {

        await prisma.$disconnect();

    })

    .catch(async (e) => {

        console.error(e);

        await prisma.$disconnect();

        process.exit(1);

    });